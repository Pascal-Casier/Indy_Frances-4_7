son = ExtResource("23_f7veu")
text1 = "Le son [ɛj] (ei / ey / ail parfois)

Son : [ɛj] – comme “oreille”, “seize”.
[color=#2E8B57]Som: [ɛj] – como “orelha”, “dezesseis”.[/color]

Prononciation : commence par le son ouvert [ɛ], puis glisse vers [j].
[color=#2E8B57]Pronúncia: começa com o som aberto [ɛ] e desliza para [j].[/color]"
text2 = "[center]
Exemples :

oreille /ɔʁɛj/ – [color=#2E8B57]orelha[/color]

seize /sɛz/ – [color=#2E8B57]dezesseis[/color]

abeille /abɛj/ – [color=#2E8B57]abelha[/color]
[/center]"

[node name="Panneau_affiche17" parent="affiches2" unique_id=255422301 instance=ExtResource("5_tp444")]
transform = Transform3D(-2, 0, -1.26162e-06, 0, 2, 0, 1.26162e-06, 0, -2, 65.91637, 11.0092, -139.46547)
son = ExtResource("24_0ewui")
text1 = "Le son [ɲ] (gn)

Son : [ɲ] – comme “montagne”, “ligne”.
[color=#2E8B57]Som: [ɲ] – como “montanha”, “linha”.[/color]

Prononciation : la langue touche le palais comme pour “nh” en portugais — c’est presque identique !
[color=#2E8B57]Pronúncia: a língua encosta no palato como no “nh” do português — é quase igual![/color]"
text2 = "[center]
Exemples :

montagne /mɔ̃taɲ/ – [color=#2E8B57]montanha[/color]

ligne /liɲ/ – [color=#2E8B57]linha[/color]

Espagne /ɛspaɲ/ – [color=#2E8B57]Espanha[/color]
[/center]"

[node name="Panneau_affiche2" parent="affiches2" unique_id=807388245 instance=ExtResource("5_tp444")]
transform = Transform3D(3.89414e-07, 0, 2, 0, 2, 0, -2, 0, 3.89414e-07, 16.8804, 8.00461, 6.0422)
son = ExtResource("7_0a6j2")
text1 = "Le son [e] (é)

Son : [e] – comme dans “clé”, “été”.
[color=#2E8B57]Som: [e] – como em “chave”, “verão”.[/color]

Prononciation : c’est un son fermé, la bouche est légèrement souriante.
[color=#2E8B57]Pronúncia: é um som fechado, a boca fica levemente sorridente.[/color]"
text2 = "[center]

Exemples :

clé /kle/ – [color=#2E8B57]chave[/color]

été /ete/ – [color=#2E8B57]verão[/color]

début /deby/ – [color=#2E8B57]início[/color]

[/center]"

