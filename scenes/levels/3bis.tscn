[node name="Intro_message" parent="." unique_id=133134756 instance=ExtResource("90_p5vft")]
pausing = true
mon_text = "
[center][color=blue]Dans cette pièce, les mots prennent vie lorsqu’ils sont bien prononcés.[/color]
[color=#2E8B57]Neste lugar, as palavras ganham vida quando são bem pronunciadas.[/color]
[color=blue]Les murs écoutent, les objets répondent, et le silence lui-même attend ta voix.[/color]
[color=#2E8B57]As paredes escutam, os objetos respondem, e até o silêncio espera pela tua voz.[/color]
[color=blue]Parle avec attention, écoute avec soin.[/color]
[color=#2E8B57]Fala com atenção, escuta com cuidado.[/color]
[color=blue]Ici, chaque son juste ouvre le chemin.[/color]
[color=#2E8B57]Aqui, cada som correto abre o caminho.[/color]
[/center]



"
audio = ExtResource("91_iaqks")

