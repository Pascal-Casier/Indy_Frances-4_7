[node name="Panneau_affiche" parent="affiches2" unique_id=538876302 instance=ExtResource("5_tp444")]
transform = Transform3D(1.58151e-06, 0, -2, 0, 2, 0, 2, 0, 1.58151e-06, 37.7514, 4.00462, -35.04575)
son = ExtResource("6_x1h1c")
text1 = "Le son [ə] (e muet)

Son : [ə] – très faible, parfois presque silencieux.
[color=#2E8B57]Som: [ə] – muito fraco, às vezes quase silencioso.[/color]

Prononciation : les lèvres sont détendues, le son est rapide.
[color=#2E8B57]Pronúncia: os lábios ficam soltos, o som é rápido.[/color]"
text2 = "[center]
Exemples :

le /lə/ – [color=#2E8B57]o/a[/color]

je /jə/ – [color=#2E8B57]o[/color]

petite /pətit/ – [color=#2E8B57]pequena[/color]

[/center]"

[node name="Panneau_affiche7" parent="affiches2" unique_id=2042987678 instance=ExtResource("5_tp444")]
transform = Transform3D(-1.75636e-06, 0, 2, 0, 2, 0, -2, 0, -1.75636e-06, -38.2486, 4.00462, -97.2326)
son = ExtResource("13_0j76k")
text1 = "Le son [u]

Son : [u] – comme “loup”, “pouce”.
[color=#2E8B57]Som: [u] – como “lobo”, “polegar”.[/color]

Prononciation : lèvres très arrondies et projetées vers l’avant.
[color=#2E8B57]Pronúncia: lábios bem arredondados e projetados para frente.[/color]"
text2 = "[center]
Exemples :

loup /lu/ – [color=#2E8B57]lobo[/color]

roue /ʁu/ – [color=#2E8B57]roda[/color]

pouce /pus/ – [color=#2E8B57]polegar[/color]
[/center]"

[node name="Panneau_affiche8" parent="affiches2" unique_id=185135105 instance=ExtResource("5_tp444")]
transform = Transform3D(1.73205, 0, 1, 0, 2, 0, -1, 0, 1.73205, -33.2486, 7.00462, -164.233)
son = ExtResource("14_i6ndu")
text1 = "Le son [y] (u français)

Son : [y] – très difficile pour les lusophones !
[color=#2E8B57]Som: [y] – muito difícil para os lusófonos![/color]

Prononciation : comme le [u] français mais avec la langue en position de [i].
[color=#2E8B57]Pronúncia: como o som [u] francês, mas com a língua na posição de [i].[/color]"
text2 = "[center]
Exemples :

lune /lyn/ – [color=#2E8B57]lua[/color]

lumière /lymjɛʁ/ – [color=#2E8B57]luz[/color]

musique /myzik/ – [color=#2E8B57]música[/color]
[/center]"

[node name="Panneau_affiche9" parent="affiches2" unique_id=1875968048 instance=ExtResource("5_tp444")]
transform = Transform3D(1.69873e-06, 0, -2, 0, 2, 0, 2, 0, 1.69873e-06, 13.7514, 5.00923, -164.233)
son = ExtResource("15_q60su")
text1 = "Le son [o]

Son : [o] – fermé, comme “eau”, “mot”.
[color=#2E8B57]Som: [o] – fechado, como “água”, “palavra”.[/color]

Prononciation : lèvres arrondies mais plus fermées que pour [ɔ].
[color=#2E8B57]Pronúncia: lábios arredondados, mas mais fechados que para [ɔ].[/color]"
text2 = "[center]
Exemples :

eau /o/ – [color=#2E8B57]água[/color]

mot /mo/ – [color=#2E8B57]palavra[/color]

chaud /ʃo/ – [color=#2E8B57]quente[/color]
[/center]"

[node name="Panneau_affiche10" parent="affiches2" unique_id=1417135074 instance=ExtResource("5_tp444")]
transform = Transform3D(-1.7950181, 0, 0.88199204, 0, 2, 0, -0.88199204, 0, -1.7950181, 10.453178, 9.00923, -118.504906)
son = ExtResource("16_ki12r")
text1 = "Le son [ɔ]

Son : [ɔ] – ouvert, comme “porte”, “fort”.
[color=#2E8B57]Som: [ɔ] – aberto, como “porta”, “forte”.[/color]

Prononciation : bouche plus ouverte que pour [o], lèvres arrondies.
[color=#2E8B57]Pronúncia: boca mais aberta do que no som [o], lábios arredondados.[/color]"
text2 = "[center]
Exemples :

porte /pɔʁt/ – [color=#2E8B57]porta[/color]

fort /fɔʁ/ – [color=#2E8B57]forte[/color]

sort /sɔʁ/ – [color=#2E8B57]sorte/destino[/color]
[/center]"

[node name="Panneau_affiche11" parent="affiches2" unique_id=671938921 instance=ExtResource("5_tp444")]
transform = Transform3D(-2, 0, -1.61131e-06, 0, 2, 0, 1.61131e-06, 0, -2, 33.7514, 4.00923, -91.6147)
son = ExtResource("17_ilkgb")
text1 = "Le son [ɑ̃] (an / en)

Son : nasal [ɑ̃] – comme “sans”, “enfant”.
[color=#2E8B57]Som nasal [ɑ̃] – como “sem”, “criança”.[/color]

Prononciation : l’air passe par le nez, la bouche est ouverte.
[color=#2E8B57]Pronúncia: o ar passa pelo nariz, a boca fica aberta.[/color]"
text2 = "[center]
Exemples :

sans /sɑ̃/ – [color=#2E8B57]sem[/color]

enfant /ɑ̃fɑ̃/ – [color=#2E8B57]criança[/color]

manger /mɑ̃ʒe/ – [color=#2E8B57]comer[/color]
[/center]"

[node name="Panneau_affiche12" parent="affiches2" unique_id=2115410662 instance=ExtResource("5_tp444")]
transform = Transform3D(-1.52389e-06, 0, 2, 0, 2, 0, -2, 0, -1.52389e-06, -6.2486, 13.0092, -136.615)
son = ExtResource("18_f5km8")
text1 = "Le son [õ] (on)

Son nasal [õ] – comme “nom”, “bon”.
[color=#2E8B57]Som nasal [õ] – como “nome”, “bom”.[/color]

Prononciation : lèvres arrondies, air par le nez.
[color=#2E8B57]Pronúncia: lábios arredondados, ar pelo nariz.[/color]"
text2 = "[center]
Exemples :

nom /nõ/ – [color=#2E8B57]nome[/color]

bon /bõ/ – [color=#2E8B57]bom[/color]

long /lõ/ – [color=#2E8B57]longo[/color]
[/center]"

[node name="Panneau_affiche13" parent="affiches2" unique_id=1607415390 instance=ExtResource("5_tp444")]
transform = Transform3D(2, 0, 1.43646e-06, 0, 2, 0, -1.43646e-06, 0, 2, -6.2486, 20.0092, -131.5)
son = ExtResource("19_o4pvh")
text1 = "Le son [ɛ̃] (in / ain / un)

Son nasal [ɛ̃] – comme “pain”, “vin”.
[color=#2E8B57]Som nasal [ɛ̃] – como “pão”, “vinho”.[/color]

Prononciation : bouche semi-ouverte, air par le nez.
[color=#2E8B57]Pronúncia: boca semiaberta, ar pelo nariz.[/color]"
text2 = "[center]
Exemples :

pain /pɛ̃/ – [color=#2E8B57]pão[/color]

vin /vɛ̃/ – [color=#2E8B57]vinho[/color]

lundi /lœ̃di/ – [color=#2E8B57]segunda-feira[/color]
[/center]"

[node name="Panneau_affiche14" parent="affiches2" unique_id=478358722 instance=ExtResource("5_tp444")]
transform = Transform3D(2, 0, 1.43646e-06, 0, 2, 0, -1.43646e-06, 0, 2, 45.7514, 11.0092, -155.01007)
son = ExtResource("20_gblhl")
text1 = "Le son [wa] (oi)

Son : [wa] – comme “moi”, “trois”.
[color=#2E8B57]Som: [wa] – como “eu”, “três”.[/color]

Prononciation : commence par un son proche de [o], puis glisse vers [a].
[color=#2E8B57]Pronúncia: começa com um som próximo de [o] e desliza para [a].[/color]"
text2 = "[center]
Exemples :

moi /mwa/ – [color=#2E8B57]eu[/color]

toi /twa/ – [color=#2E8B57]você[/color]

trois /tʁwa/ – [color=#2E8B57]três[/color]
[/center]"

[node name="Panneau_affiche15" parent="affiches2" unique_id=1816423923 instance=ExtResource("5_tp444")]
transform = Transform3D(2, 0, 1.43646e-06, 0, 2, 0, -1.43646e-06, 0, 2, 55.7514, 11.0092, -155.01007)
son = ExtResource("21_ad2j2")
text1 = "Le son [aj] (ai / ay / aï)

Son : [aj] – comme “travail”, “paille”.
[color=#2E8B57]Som: [aj] – como “trabalho”, “palha”.[/color]

Prononciation : commence par [a] puis glisse vers un [j] (son de “i”).
[color=#2E8B57]Pronúncia: começa com [a] e desliza para [j] (som de “i”).[/color]"
text2 = "[center]
Exemples :

travail /tʁavaj/ – [color=#2E8B57]trabalho[/color]

paille /paj/ – [color=#2E8B57]palha[/color]

taille /taj/ – [color=#2E8B57]tamanho[/color]
[/center]"

[node name="Panneau_affiche18" parent="affiches2" unique_id=1934343877 instance=ExtResource("5_tp444")]
transform = Transform3D(2, 0, 1.43646e-06, 0, 2, 0, -1.43646e-06, 0, 2, 65.7514, 11.0092, -155.01007)
son = ExtResource("22_qfcmt")
text1 = "Le son [ij] / [j] (ill)

(selon le contexte)

Son : [ij] ou [j] – comme “fille”, “famille”.
[color=#2E8B57]Som: [ij] ou [j] – como “menina”, “família”.[/color]

Prononciation : souvent, “ill” se prononce comme une semi-voyelle [j].
[color=#2E8B57]Pronúncia: muitas vezes, “ill” se pronuncia como a semivogal [j].[/color]"
text2 = "[center]
fille /fij/ – [color=#2E8B57]menina[/color]

famille /famij/ – [color=#2E8B57]família[/color]

briller /bʁije/ – [color=#2E8B57]brilhar[/color]
[/center]"

[node name="Panneau_affiche16" parent="affiches2" unique_id=783553610 instance=ExtResource("5_tp444")]
