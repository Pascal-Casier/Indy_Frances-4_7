titre = "AVOIR + ÊTRE"
texte = "Tu [es|est|suis] content parce que tu [as|a|ai] un cadeau. Il [est|es|sont] malade et il [a|as|ont] de la fièvre. Nous [sommes|êtes|sont] prêts : nous [avons|avez|ont] nos billets. Vous [êtes|sommes|sont] gentils et vous [avez|avons|ont] raison."
